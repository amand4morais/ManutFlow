# Configurações do Sistema de Manutenção
# Renomeie este arquivo para .env e coloque sua chave abaixo

# Chave API do Groq (Obtenha em: https://console.groq.com/)
GROQ_API_KEY=sua_chave_aqui_sem_aspas

# Configurações do Flask
SECRET_KEY=uma-chave-secreta-muito-segura
DEBUG=True

# Modelo da IA
GROQ_MODEL=llama-3.3-70b-versatile
